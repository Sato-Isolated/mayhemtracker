{
  "name": "mayhemtracker",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"pnpm --filter client dev\" \"pnpm --filter server dev\"",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter client build && pnpm --filter server build",
    "db:reset": "pnpm --filter server db:reset",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:import-legacy": "pnpm --filter server db:import-legacy",
    "db:rebuild": "pnpm --filter server db:rebuild",
    "test": "pnpm test:client && pnpm test:server",
    "test:client": "pnpm --filter client test",
    "test:server": "pnpm --filter server test",
    "verify": "pnpm test && pnpm build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1"
  }
}
